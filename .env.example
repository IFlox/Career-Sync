careersync/
├── .gitignore
├── README.md
├── docker-compose.yml              # Optional: Run full stack in one command
├── package.json                    # Root package to launch both with `npm run dev`
│
├── backend/                        # 🐍 Python / FastAPI Service (Port 8000)
│   ├── .env
│   ├── .env.example
│   ├── requirements.txt
│   ├── main.py                     # App entry point, CORS & router mounting
│   ├── data_seeds.py               # Seed jobs, students (88%, 58%, 35%), courses & hackathons
│   ├── services/
│   │   ├── __init__.py
│   │   ├── pii_scrubber.py         # Regex masking (phone, email, address)
│   │   ├── resume_auditor.py       # Impact score (0-100), weak bullet rewrites & ATS layout
│   │   ├── matching_engine.py      # Vector cosine similarity & SOP constraints (CGPA/Apps)
│   │   ├── market_radar.py         # Layoff risk index & skill demand taxonomy
│   │   └── interview_agent.py      # Adaptive mock interviewer & dynamic rubric
│   └── routes/
│       ├── __init__.py
│       ├── student_routes.py       # /api/v1/students/*
│       └── admin_routes.py         # /api/v1/admin/* (Protected by PIN/Bearer)
│
└── frontend/                       # ⚡ React + Vite + Tailwind (Port 5173)
    ├── .env
    ├── .env.example
    ├── index.html
    ├── package.json
    ├── vite.config.js              # Includes API proxy to backend:8000 (No CORS issues!)
    ├── tailwind.config.js          # Bento aesthetic (porcelain canvas, terracotta accents)
    ├── postcss.config.js
    └── src/
        ├── main.jsx
        ├── App.jsx                 # Root layout, role switcher & modal gateway
        ├── index.css               # Tailwind directives & bento styles
        ├── api/
        │   └── client.js           # Centralized fetch wrapper for FastAPI endpoints
        ├── components/
        │   ├── Navbar.jsx          # Top bento navigation & TPO lock
        │   ├── ReasoningTrace.jsx  # Real-time collapsible agent execution drawer
        │   ├── StudentPortal.jsx   # CV audit, match dial, radar & roadmap
        │   ├── MockInterview.jsx   # Adaptive voice/text terminal (webkitSpeech)
        │   ├── ATSPreviewModal.jsx # Single-column ATS standardized preview
        │   └── AdminPortal.jsx     # TPO verification matrix, SLA flags & CSV export
        └── data/
            ├── seedData.js         # Offline fallback seeds for zero downtime
            └── marketTaxonomy.js   # Client-side taxonomy categories