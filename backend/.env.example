# CareerSync backend configuration example.
# Copy this file to backend/.env and replace the placeholder values for your
# machine. Never commit backend/.env, and never put a real password in a
# DATABASE_URL that is tracked by git.

PORT=8000
SECRET_KEY=careersync_secret_jwt_key_2026
ADMIN_PIN=tpo_secure_2026
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GROQ_API_KEY=groq_api_key_here

# ---------------------------------------------------------------------------
# Database selection
# ---------------------------------------------------------------------------
# PostgreSQL is the default backend. Replace YOUR_USER and YOUR_PASSWORD with
# your local PostgreSQL credentials. The backend does NOT silently fall back
# to SQLite if PostgreSQL is unreachable; startup fails with an actionable
# error instead. A plain postgresql:// URL is normalized to the psycopg2
# driver used by requirements.txt.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/careersync

# If DATABASE_URL is absent or blank, the backend also defaults to local
# PostgreSQL at postgresql://postgres:postgres@localhost:5432/careersync.

# SQLite is opt-in only. To use SQLite instead, replace the PostgreSQL URL
# above with an explicit sqlite:// URL. SQLite is never selected automatically.
#
# DATABASE_URL=sqlite:///./careersync.db

# Verify PostgreSQL is running and accepting connections on Windows
# (PowerShell), before starting the backend:
#
#   Get-Service -Name 'postgresql*'
#   Test-NetConnection -ComputerName localhost -Port 5432
#   pg_isready -h localhost -p 5432 -U postgres
#   psql -h localhost -p 5432 -U postgres -d careersync
#
# If the database does not exist yet, create it once (for example):
#
#   createdb -h localhost -p 5432 -U postgres careersync
#   # or, inside psql:
#   CREATE DATABASE careersync;
#
# Troubleshooting:
#   * "connection refused" means nothing is listening on the configured
#     host/port. Start the PostgreSQL Windows service and retry.
#   * "password authentication failed" means the username/password or the
#     pg_hba.conf authentication method needs to be corrected.
#   * A blank/whitespace-only DATABASE_URL is treated as "not configured"
#     and selects the default local PostgreSQL backend.
