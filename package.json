{
  "name": "careersync-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend": "cd backend && python main.py",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}